  {
    "id": "function_processar",
    "type": "function",
    "z": "tab_space_capsule",
    "name": "Processar Status",
    "func": "let temperatura = Number(msg.payload.temperatura);\nlet umidade = Number(msg.payload.umidade);\nlet status = \"NORMAL\";\nlet alerta = \"Condições internas estáveis.\";\n\nif (temperatura >= 40) {\n    status = \"FALHA NO RESFRIAMENTO\";\n    alerta = \"ALERTA: falha no sistema de resfriamento da cápsula.\";\n} else if (temperatura >= 35) {\n    status = \"CRÍTICO\";\n    alerta = \"ALERTA: temperatura crítica dentro da cápsula.\";\n} else if (temperatura >= 25) {\n    status = \"ATENÇÃO\";\n    alerta = \"Atenção: temperatura acima do ideal.\";\n}\n\nmsg.payload = {\n    temperatura: temperatura,\n    umidade: umidade,\n    status: status,\n    alerta: alerta,\n    horario: new Date().toLocaleString()\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 100,
    "wires": [
      [
        "gauge_temp",
        "chart_temp",
        "text_status",
        "text_alerta",
        "debug"
      ]
    ]
  },
